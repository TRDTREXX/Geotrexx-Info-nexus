        {/* Editorial Subtitle */}
        <p className="text-lg md:text-xl text-gray-700 dark:text-gray-300 font-medium leading-relaxed mb-8 transition-colors duration-300" style={{ fontFamily: 'Newsreader, Georgia, serif' }}>
