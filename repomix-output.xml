      {
        "title": "Ballon d’Or Official Statement: World Cup Glory Alone Cannot Guarantee Football’s Biggest Individual Award",
        "slug": "ballon-dor-official-statement-world-cup-glory-alone-cannot-guarantee-footballs-biggest-individual-award",
